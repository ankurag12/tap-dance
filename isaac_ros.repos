# vcstool manifest — external SOURCE dependencies for the Isaac ROS workspace.
#
# These repos are cloned as *siblings* of this one under the workspace `src/`.
# They are intentionally NOT committed into this repo; this file pins their
# versions so the environment can be rebuilt on a fresh board.
#
# Usage (from the workspace root, e.g. ~/workspaces/isaac_ros-dev):
#   vcs import src < src/playground/isaac_ros.repos
#   # then, inside the dev container, resolve binary deps + build:
#   rosdep install --from-paths src --ignore-src -y
#   colcon build --symlink-install
#
# NOTE on reproducibility: `release-3.2` is a release *branch*, not a fixed tag,
# so it can still move. For a truly frozen environment, replace `version:` with
# the exact commit hash you validated against.
# NOTE: realsense-ros is intentionally NOT listed here. The Isaac ROS container's
# `realsense` image layer (Dockerfile.realsense, enabled via the ros2_humble.realsense
# image key) already builds and installs a matched pair into the image:
#   - librealsense    v2.55.1        (built from source)
#   - realsense2_camera release/4.51.1-isaac  (ROS wrapper, built against that librealsense)
# Cloning realsense-ros into the workspace would pull a newer version that expects a
# newer librealsense than 2.55.1, causing a mismatch. Use the baked-in one instead.
repositories:
  isaac_ros_common:
    type: git
    url: https://github.com/NVIDIA-ISAAC-ROS/isaac_ros_common.git
    version: release-3.2
  isaac_ros_apriltag:
    type: git
    url: https://github.com/NVIDIA-ISAAC-ROS/isaac_ros_apriltag.git
    version: release-3.2
